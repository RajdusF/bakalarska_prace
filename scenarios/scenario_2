files = input output/bionano_files.txt

sort added by modified
select top 5

remove *
add *


finds_version = find "Version" in added -I
find "Number of Molecules" in added -I

print(finds_version)
my_report = ""

for key, values in finds_version.items():
    print(key)
    my_report += str(key) + "\n"
    for value in values:
        print(f"\t{value}")
        my_report += "\t" + str(value) + "\n"
    print()
    my_report += "\n"


send_email(my_report, "Function find")